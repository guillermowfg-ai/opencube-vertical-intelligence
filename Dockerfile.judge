# Hosted Judge Mode image — public, read-only.
#
# Deliberately separate from opencube-intel/Dockerfile, which builds the
# accepted private production image and is not touched by this milestone. The
# two differ in exactly two ways that matter, and both are here rather than in
# a runtime flag someone can get wrong:
#
#   * the entrypoint is app.judge_app, which registers no mutating route, so
#     this image cannot start the production write application even by
#     accident; and
#   * the interface is compiled with VITE_EXECUTION_MODE=readonly, which makes
#     the API client's only write a rejection stub at build time. The verify
#     step below fails the build if that did not happen.
#
# Build context is the repository root, because the image needs both the
# backend and the compiled interface.

# --- stage 1: the read-only interface -------------------------------------
FROM node:22-slim AS interface

WORKDIR /ui

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# Judge Mode. This is a build-time constant, not a runtime setting: the launch
# path is eliminated from the bundle rather than hidden in it.
ENV VITE_EXECUTION_MODE=readonly
RUN npm run build && node scripts/verify-judge-bundle.mjs dist

# --- stage 2: the read-only server ----------------------------------------
FROM python:3.12-slim

RUN pip install --no-cache-dir uv==0.8.13

WORKDIR /code

COPY opencube-intel/pyproject.toml opencube-intel/README.md opencube-intel/uv.lock* ./
COPY opencube-intel/app ./app

RUN uv sync --frozen

COPY --from=interface /ui/dist ./static
ENV JUDGE_STATIC_DIR=/code/static

# No GOOGLE_GENAI_USE_VERTEXAI, no TASKS_QUEUE, no TASKS_LOCATION, no
# SERVICE_URL, no TASK_INVOKER_SA. The judge runtime is given no analytical
# configuration at all, and its service account holds no role that would let it
# use one.

EXPOSE 8080

CMD ["uv", "run", "uvicorn", "app.judge_app:app", "--host", "0.0.0.0", "--port", "8080"]
